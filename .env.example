# Nothing here is required. The batch executor never needs a private key: the wallet signs.
# PHAROS_RPC_URL=https://rpc.pharos.xyz      # another Pacific RPC
# PHAROS_RPC_CONCURRENCY=2                   # parallel requests (the public gateway rate-limits bursts)
# ANVIL_BIN=                                 # an Anvil binary for the fork demo (default: the npm package)
# FORK_PORT=8549
# PORT=3130                                  # the local demo site
